# ---- toolkit runtime output (never commit) ----
# browser.py cookies --out : real session cookies. Keep these out of git.
cookies.json
cookies*.json
*.cookies.json
c.json

# Browser profiles hold live logins. They normally live in
# ~/.claude/browser-profiles/, but ignore any local copy too.
browser-profiles/
.cdp.json

# screen.py / browser.py state and default output filenames
.screen-state.json
.desk-scale
shot.png
page.png
page.pdf
screenshots/
downloads/

# ---- python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# virtualenvs
venv/
.venv/
env/
.env/
ENV/

# test / lint / type caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
test-output/
.hypothesis/

# ---- secrets ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.json
token.txt
credentials.json

# ---- logs / temp ----
*.log
logs/
*.tmp
*.temp
tmp/
temp/
.cache/

# ---- editors ----
.vscode/
.idea/
*.swp
*.swo
*~
.sublime-*

# ---- os ----
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
